<Application x:Class="DatasetCropper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- App-level tweaks on top of the Material Design theme.
                     The BundledTheme + MaterialDesignTheme.Default.xaml are
                     injected from App.OnStartup (Services/AppTheme) based on
                     the system light/dark setting; this file's setters are
                     applied last and therefore override the stock styles. -->
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
