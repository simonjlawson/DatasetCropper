<Window x:Class="DatasetCropper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DatasetCropper.Converters"
        Title="DatasetCropper — AI training image processor"
        Height="720" Width="1080"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="0,0,0,8">

            <!-- ============ Process tab ============ -->
            <TabItem Header="Process">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Header="Processing stages — unchecked stages are skipped" Margin="0,0,8,8" Padding="6"
                              IsEnabled="{Binding IsRunning, Converter={x:Static local:InverseBoolConverter.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Topaz" IsChecked="{Binding StageTopaz}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox Content="Auto Crops" IsChecked="{Binding StageMultiCrop}" VerticalAlignment="Center" Margin="0,0,8,0"
                                      ToolTip="When checked, emit one extra 1024x1024 crop centered on the dominant concept (in addition to tiles)"/>
                            <CheckBox Content="Detect Concepts" IsChecked="{Binding StageDetect}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox Content="Detect Subjects" IsChecked="{Binding StageSubjects}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox Content="Masks" IsChecked="{Binding StageMasks}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox Content="Captions" IsChecked="{Binding StageCaptions}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox Content="Dedupe" IsChecked="{Binding StageDedupe}" VerticalAlignment="Center"
                                      ToolTip="Move crops similar to another crop out to a 'duplicates' folder"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Header="Image queue" Margin="0,0,8,0" Padding="6">
                        <ListView x:Name="QueueList" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0"
                                                          SelectionMode="Extended" SelectionChanged="QueueList_SelectionChanged"
                                                          PreviewKeyDown="QueueList_PreviewKeyDown">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource MaterialDesignBodyForeground}"/>

                                        <TextBlock Grid.Column="1" Text="{Binding Status}" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidForeBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Done">
                                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                                            <Setter Property="Foreground" Value="#F44336"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                                            <Setter Property="Foreground" Value="#999999"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Button Grid.Column="3" Content="Open" Margin="8,0,0,0" Padding="10,2"
                                                Style="{DynamicResource MaterialDesignFlatButton}"
                                                Command="{Binding OpenFolderCommand}"
                                                ToolTip="{Binding OutputFolder}"
                                                Visibility="{Binding OutputFolder, Converter={x:Static local:NullStringToCollapsedConverter.Instance}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </GroupBox>
                    <GroupBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Header="Mask terms" Margin="0,8,8,0" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Optional terms to mask, one per line. These are independent of composition and subject terms; matching regions are combined into the mask for every output crop. Leave empty to use the detected composition/subject terms."
                                       Foreground="{DynamicResource MaterialDesignBodyForeground}" Margin="0,0,0,4"
                                       TextWrapping="Wrap"/>
                            <TextBox Text="{Binding MaskTermsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="3" Grid.Column="0" Header="Caption" Margin="0,8,8,0" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Text written before the WD14 tags in every .txt caption (e.g. 'koi pond'). Empty = no prefix."
                                       Foreground="{DynamicResource MaterialDesignBodyForeground}" Margin="0,0,0,4"
                                       TextWrapping="Wrap"/>
                            <TextBox Text="{Binding CaptionPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Header="Log" Margin="0,0,8,0" Padding="6">
                        <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}"
                                 IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 Foreground="{DynamicResource MaterialDesignBodyForeground}"
                                 TextWrapping="NoWrap"
                                 TextChanged="LogBox_TextChanged"
                                 PreviewMouseWheel="LogBox_PreviewMouseWheel"
                                 PreviewKeyDown="LogBox_PreviewKeyDown"/>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Grid.Column="1" Header="Composition" Margin="0,0,8,0" Padding="8">
                        <StackPanel>
                            <TextBlock Text="One composition per line. Determines the image composition and the output folder. e.g. wideangle, closeup, landscape"
                                       Foreground="{DynamicResource MaterialDesignBodyForeground}" Margin="0,0,0,4"
                                       TextWrapping="Wrap"/>
                            <TextBox x:Name="ConceptsBox"
                                     Text="{Binding ConceptsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Grid.Column="2" Header="Subjects" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Optional 2nd list, one per line. Each match is zoomed into a 1:1 crop (min 1024x1024) from the original image and saved to its own folder."
                                       Foreground="{DynamicResource MaterialDesignBodyForeground}" Margin="0,0,0,4"
                                       TextWrapping="Wrap"/>
                            <TextBox x:Name="SubjectConceptsBox"
                                     Text="{Binding SubjectConceptsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                        </StackPanel>
                    </GroupBox>
                    </Grid>
                </TabItem>

                <!-- ============ Crop tab ============ -->
                <TabItem Header="Crop">
                    <Grid Margin="6" Loaded="CropTab_Loaded" PreviewKeyDown="CropTab_PreviewKeyDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="Source image" Margin="0,0,8,0" Padding="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" x:Name="CropCanvasHost" Background="#111111"
                                      MouseMove="CropCanvas_MouseMove"
                                      MouseLeftButtonUp="CropCanvas_MouseLeftButtonUp"
                                      MouseWheel="CropCanvas_MouseWheel"
                                      SizeChanged="CropCanvasHost_SizeChanged">
                                    <Image Source="{Binding Crop.ImageSource}" Stretch="Uniform"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Canvas IsHitTestVisible="False">
                                        <Rectangle Canvas.Left="{Binding Crop.BoxLeft, Mode=OneWay}"
                                                   Canvas.Top="{Binding Crop.BoxTop, Mode=OneWay}"
                                                   Width="{Binding Crop.BoxWidth, Mode=OneWay}"
                                                   Height="{Binding Crop.BoxHeight, Mode=OneWay}"
                                                   Stroke="#FFC400" StrokeThickness="2" Fill="#22FFC400"
                                                   Visibility="{Binding Crop.BoxVisible, Converter={StaticResource BoolToVis}}"/>
                                    </Canvas>
                                    <TextBlock Text="No image yet — add some on the Process tab, or 'Open image…' below.&#10;Move the mouse to aim the crop box (centered on the cursor); scroll to resize it; click to save."
                                               TextAlignment="Center" FontSize="13" Foreground="#888888"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                               Visibility="{Binding Crop.HasImage, Converter={x:Static local:InverseBoolToVisibilityConverter.Instance}}"/>
                                </Grid>

                                <Grid Grid.Row="1" Margin="2,6,2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="◀ Prev" Command="{Binding Crop.PrevCommand}"
                                            Padding="8,2" Margin="0,0,8,0" IsEnabled="{Binding Crop.CanNavigate}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Crop.PositionText}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MaterialDesignBodyForeground}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource MaterialDesignBodyForeground}">
                                        <Run Text="{Binding Crop.ImageName, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Crop.ImageSize, Mode=OneWay}"/>
                                    </TextBlock>
                                    <Button Grid.Column="3" Content="Next ▶" Command="{Binding Crop.NextCommand}"
                                            Padding="8,2" Margin="8,0,0,0" IsEnabled="{Binding Crop.CanNavigate}"/>
                                </Grid>
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Crops — saved crops become source images for the Process tab" Padding="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,2,0,6">
                                    <TextBlock Text="Crop size" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{DynamicResource MaterialDesignBodyForeground}"/>
                                    <ComboBox Width="70" Margin="0,0,8,0" IsEditable="True"
                                              Text="{Binding Crop.CropSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding Crop.CropSizes}"
                                              ToolTip="Crop box size in original-image pixels — pick one or scroll over the source image to adjust"/>
                                    <TextBlock Text="px — 1:1 square" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MaterialDesignBodyForeground}"/>
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,0,0,6">
                                    <Border Background="#0A0A0A" CornerRadius="2">
                                        <Image Source="{Binding Crop.CropPreview}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <TextBlock Text="Live crop preview" FontSize="11" Foreground="#666666"
                                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,8"/>
                                </Grid>

                                <GroupBox Grid.Row="2" Header="Saved crops" Margin="0,0,0,6" Padding="2">
                                    <Grid>
                                        <ListBox ItemsSource="{Binding Crop.Crops}"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Background="Transparent" BorderThickness="0">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Margin" Value="3"/>
                                                    <Setter Property="Width" Value="120"/>
                                                    <Setter Property="Padding" Value="3"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                            BorderThickness="1" CornerRadius="2">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="104"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid Grid.Row="0">
                                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                <Button Content="✕" Width="22" Height="22" FontSize="11" Padding="0"
                                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                                                        Command="{Binding DeleteCommand}"
                                                                        ToolTip="Delete this crop"/>
                                                            </Grid>
                                                            <TextBlock Grid.Row="1" Text="{Binding FileName}" Margin="4,2,4,4" FontSize="11"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource MaterialDesignBodyForeground}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="Nothing cropped yet."
                                                   Foreground="{DynamicResource MaterialDesignBodyForeground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding Crop.HasCrops, Converter={x:Static local:InverseBoolToVisibilityConverter.Instance}}"/>
                                    </Grid>
                                </GroupBox>

                                <StackPanel Grid.Row="3" Orientation="Vertical">
                                    <TextBlock Text="{Binding Crop.Status}" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource MaterialDesignBodyForeground}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Save crop" Command="{Binding Crop.CommitCropCommand}"
                                                Padding="8,2" Margin="0,0,8,0" IsEnabled="{Binding Crop.HasImage}"/>
                                        <Button Content="Open image…" Command="{Binding Crop.OpenImageCommand}"
                                                                                     Padding="8,2" Margin="0,0,8,0"/>
                                        <Button Content="Add crops to queue" Command="{Binding Crop.AddCropsToQueueCommand}"
                                                Padding="8,2" Margin="0,0,8,0"
                                                ToolTip="Queue the saved crops on the Process tab so they can be run as source images"/>
                                        <Button Content="Crops folder" Command="{Binding Crop.OpenCropsFolderCommand}"
                                                Style="{DynamicResource MaterialDesignFlatButton}" Padding="8,2"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <!-- ============ Output tab ============ -->
                <TabItem Header="Output">
                <Grid Margin="6"
                      Loaded="OutputTab_Loaded"
                      PreviewKeyDown="OutputTab_PreviewKeyDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource MaterialDesignBodyForeground}"/>
                        <ComboBox MinWidth="160"
                                  ItemsSource="{Binding Output.Filters}"
                                  SelectedItem="{Binding Output.Filter}"
                                  ToolTip="Only show images from this folder"/>
                        <Button Content="Refresh" MinWidth="80" Padding="8,2" Margin="10,0,0,0"
                                Command="{Binding Output.RefreshAllCommand}"
                                ToolTip="Show all images again (including ones you've confirmed or moved) and clear the filter"/>
                    </StackPanel>

                    <GroupBox Grid.Row="1" Grid.Column="0" Header="Processed images" Margin="0,0,8,0" Padding="0">
                        <Grid>
                            <ListBox x:Name="OutputList" ItemsSource="{Binding Output.Items}"
                                     SelectionMode="Extended"
                                     SelectionChanged="OutputList_SelectionChanged"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="4"/>
                                        <Setter Property="Padding" Value="4"/>
                                        <Setter Property="Width" Value="150"/>
                                        <Setter Property="Height" Value="150"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd"
                                                            Background="Transparent"
                                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                            BorderThickness="1" CornerRadius="2">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Image Grid.Row="0" Source="{Binding Thumbnail}"
                                                                   Stretch="Uniform" Margin="4"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock Grid.Row="1" Text="{Binding RelativePath}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       FontSize="11" Margin="4,2,4,4"
                                                                       Foreground="{DynamicResource MaterialDesignBodyForeground}"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                                    Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                                    Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <TextBlock Text="No images yet — run the pipeline first."
                                       Foreground="{DynamicResource MaterialDesignBodyForeground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Output.HasItems, Converter={x:Static local:InverseBoolToVisibilityConverter.Instance}}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Grid.Column="1" Header="Preview" Padding="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#111111" CornerRadius="2" Margin="0,0,0,4">
                                <Image Source="{Binding Output.Preview}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Grid.Row="1" Margin="0,0,0,4">
                                <TextBlock Text="Concept" FontSize="11"
                                           Foreground="{DynamicResource MaterialDesignBodyForeground}"/>
                                <TextBlock Text="{Binding Output.SelectedConcept}"
                                           Foreground="{DynamicResource MaterialDesignBodyForeground}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBox Grid.Row="2"
                                     Text="{Binding Output.Caption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding Output.CanEditCaption}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="56" MaxHeight="110"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" Margin="0,0,0,4"/>
                            <StackPanel Grid.Row="3" Orientation="Vertical">
                                <TextBlock Text="{Binding Output.Status}"
                                           Foreground="{DynamicResource MaterialDesignBodyForeground}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8">
                                    <Button Content="Delete selected (Del)" Command="{Binding Output.DeleteSelectedCommand}" Margin="0,0,8,0" Padding="4" />
                                    <Button Content="Confirm (Enter)"
                                        Command="{Binding Output.ConfirmAndAdvanceCommand}"
                                        Style="{DynamicResource MaterialDesignFlatButton}"
                                        Padding="4"
                                        ToolTip="Concept is correct, confirm it to move on"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Output.FolderHint}"
                                           Foreground="{DynamicResource MaterialDesignBodyForeground}"
                                           VerticalAlignment="Center" Margin="0,8" HorizontalAlignment="Left"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="Press 1-9 to assign the selected image(s) to the 1st-9th concept folder (Compositions, then Subjects); Enter confirms the current concept — both advance to the next image after a handled one"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="All to JPG" MinWidth="110" Padding="8,2"
                                        Command="{Binding Output.ConvertToJpgCommand}"
                                        VerticalAlignment="Center"
                                        ToolTip="Re-encode every output crop PNG as a same-named JPG and remove the PNG. Mask files (*-masklabel.png) stay PNG."/>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="JPG quality" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource MaterialDesignBodyForeground}"/>
                                    <Slider Width="132" Minimum="0" Maximum="2" TickFrequency="1"
                                            IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                            Value="{Binding Output.JpegQualityLevel, Mode=TwoWay}"
                                            ToolTip="Choose the JPEG conversion quality"/>
                                    <Grid Width="132">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Good" FontSize="10" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="Better" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="Best" FontSize="10" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Output.JpegQualityDescription}" FontSize="10"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource MaterialDesignBodyForeground}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ============ Settings tab ============ -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="10" IsEnabled="{Binding IsRunning, Converter={x:Static local:InverseBoolConverter.Instance}}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Folders -->
                        <GroupBox Grid.Row="0" Grid.Column="0" Header="Folders" Margin="0,0,8,8" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Output folder" Foreground="{DynamicResource MaterialDesignBodyForeground}" Margin="0,0,0,4"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding ChooseOutputFolderCommand}" Margin="4,0,0,0"/>
                                    <TextBox Text="{Binding OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <TextBlock Text="Models folder" Foreground="{DynamicResource MaterialDesignBodyForeground}" Margin="0,8,0,4"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding ChooseModelsFolderCommand}" Margin="4,0,0,0"/>
                                    <TextBox Text="{Binding ModelsFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Models -->
                        <GroupBox Grid.Row="0" Grid.Column="1" Header="Models" Margin="0,0,0,8" Padding="8">
                            <StackPanel>
                                <TextBlock Text="{Binding ModelsStatus}" Foreground="{DynamicResource PrimaryHueMidForeBrush}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Content="Check models" Command="{Binding CheckModelsCommand}" Padding="6,1" Margin="0,0,6,0"/>
                                    <Button Content="Download missing…" Command="{Binding DownloadMissingModelsCommand}" Padding="6,1"/>
                                </StackPanel>
                                <TextBlock Text="Mask model — generates the grayscale concept masks" Foreground="{DynamicResource MaterialDesignBodyForeground}" Margin="0,10,0,4"/>
                                <ComboBox ItemsSource="{Binding MaskModelOptions}"
                                          SelectedItem="{Binding SelectedMaskModel}"
                                          Width="160" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding MaskModelDescription}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{DynamicResource MaterialDesignBodyForeground}"/>
                                <TextBlock Text="Caption model — generates the .txt captions" Foreground="{DynamicResource MaterialDesignBodyForeground}" Margin="0,10,0,4"/>
                                <ComboBox ItemsSource="{Binding CaptionModelOptions}"
                                          SelectedItem="{Binding SelectedCaptionModel}"
                                          Width="160" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding CaptionModelDescription}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{DynamicResource MaterialDesignBodyForeground}"/>
                                <TextBlock Text="Detector — finds the concept/subject boxes" Foreground="{DynamicResource MaterialDesignBodyForeground}" Margin="0,10,0,4"/>
                                <ComboBox ItemsSource="{Binding DetectorModelOptions}"
                                          SelectedItem="{Binding SelectedDetectorModel}"
                                          Width="160" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding DetectorModelDescription}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{DynamicResource MaterialDesignBodyForeground}"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Thresholds -->
                        <GroupBox Grid.Row="1" Grid.Column="0" Header="Thresholds" Margin="0,0,8,8" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="WD14 tag (min confidence)" Foreground="{DynamicResource MaterialDesignBodyForeground}" Margin="0,0,4,4"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                         Text="{Binding Wd14Threshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="DINO box (min detection score)" Foreground="{DynamicResource MaterialDesignBodyForeground}" Margin="0,0,4,4"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                         Text="{Binding DinoBoxThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="DINO text (min text match score)" Foreground="{DynamicResource MaterialDesignBodyForeground}" Margin="0,0,4,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding DinoTextThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </GroupBox>

                        <!-- Topaz -->
                        <GroupBox Grid.Row="1" Grid.Column="1" Header="Upscaling (optional)" Margin="0,0,0,8" Padding="8">
                            <StackPanel>
                                <CheckBox Content="Upscale with Topaz Photo AI before processing"
                                          IsChecked="{Binding UseTopaz, Mode=TwoWay}"
                                          Foreground="{DynamicResource MaterialDesignBodyForeground}"/>
                                <TextBlock Text="tpai.exe" Foreground="{DynamicResource MaterialDesignBodyForeground}" Margin="0,6,0,4"
                                           IsEnabled="{Binding UseTopaz}"/>
                                <DockPanel IsEnabled="{Binding UseTopaz}">
                                    <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding ChooseTopazPathCommand}" Margin="4,0,0,0"/>
                                    <TextBox Text="{Binding TopazPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="Arguments (e.g. --upscale, --noise --sharpen)"
                                           Foreground="{DynamicResource MaterialDesignBodyForeground}" Margin="0,8,0,4"
                                           IsEnabled="{Binding UseTopaz}"/>
                                <TextBox Text="{Binding TopazArgs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center" IsEnabled="{Binding UseTopaz}"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Runtime -->
                        <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Header="Runtime" Padding="8">
                            <CheckBox Content="Use GPU (CUDA / DirectML) for model inference — falls back to CPU if unavailable"
                                      IsChecked="{Binding UseGpu, Mode=TwoWay}"
                                      Foreground="{DynamicResource MaterialDesignBodyForeground}"/>
                        </GroupBox>

                        <!-- Cropping -->
                        <GroupBox Grid.Row="3" Grid.Column="0" Header="Cropping" Margin="0,0,12,0" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Minimum tile overlap (px)" Foreground="{DynamicResource MaterialDesignBodyForeground}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding MinTileOverlap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Minimum subject crop resolution (px)" Foreground="{DynamicResource MaterialDesignBodyForeground}" Margin="0,8,0,4"
                                           ToolTip="Subject crops use at least this many source pixels on each side, up to the image bounds."/>
                                <TextBox Text="{Binding MinimumSubjectResolution, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Subject crops use at least this many source pixels on each side, up to the image bounds."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="3" Grid.Column="1" Header="Existing output" Padding="8">
                            <StackPanel>
                                <CheckBox Content="Append new captions to existing .txt files"
                                          IsChecked="{Binding AppendCaptions, Mode=TwoWay}"
                                          Foreground="{DynamicResource MaterialDesignBodyForeground}"
                                          ToolTip="Adds the newly generated caption on a new line instead of replacing the existing text."/>
                                <CheckBox Content="Overwrite existing images and masks"
                                          IsChecked="{Binding OverwriteOutputs, Mode=TwoWay}"
                                          Foreground="{DynamicResource MaterialDesignBodyForeground}"
                                          Margin="0,8,0,0"
                                          ToolTip="Reuses the original crop name. When unchecked, repeated runs receive a timestamped name."/>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom bar -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Add images…" Command="{Binding AddImagesCommand}"/>
            <Button Grid.Column="1" Content="Clear" Command="{Binding ClearQueueCommand}" Margin="6,0,0,0"/>
            <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{DynamicResource MaterialDesignBodyForeground}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0"/>
            <Button Grid.Column="3" Content="View output" Command="{Binding OpenOutputFolderCommand}" Margin="0,0,6,0"/>
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Content="Start" Command="{Binding StartCommand}"
                        IsEnabled="{Binding IsRunning, Converter={x:Static local:InverseBoolConverter.Instance}}"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="6,0,0,0"
                        IsEnabled="{Binding IsRunning}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
